# Private instance template only. Never overwrite an existing .env.
# Public mode needs no .env: python -m pipeline.launch --mode demo
PIPELINE_MODE=private
DEMO_MODE=false
# PIPELINE_CONFIG_PATH=pipeline_config.json
# PRIVATE_OFFLINE=true

# Enable private integrations only when explicitly configured.
OPENAI_API_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_RESUMES_FOLDER_ID=
GOOGLE_APPLICATIONS_ROOT_FOLDER_ID=
# python -m pipeline.setup_oauth (interactive private setup)
# GOOGLE_TOKEN_PATH=token.json
# GOOGLE_CREDENTIALS_PATH=credentials.json
# JSON environment alternatives: GOOGLE_TOKEN_JSON / GOOGLE_CREDENTIALS_JSON
# CANDIDATE_EMAIL=
# Optional future providers: TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER

# Public configuration is selected separately and never falls back to private:
# PIPELINE_INSTANCE_CONFIG=config/demo.json
